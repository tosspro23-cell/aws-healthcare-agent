# Copy to .env.local (gitignored) and fill in with the real deployed values:
#   AWS_PROFILE=dev aws cloudformation describe-stacks --stack-name CareAgentAuthStack \
#     --query "Stacks[0].Outputs" --output table
#   AWS_PROFILE=dev aws cloudformation describe-stacks --stack-name CareAgentApiStack \
#     --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue" --output text

# Placeholders -- this project follows the same practice as Phase 1's
# decision not to commit live deployed identifiers to a public repo's
# history unnecessarily (see docs/DECISIONS.md). Fill these in locally in
# .env.local (gitignored), not here.
VITE_COGNITO_DOMAIN=care-agent-<your-account-id>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_APP_CLIENT_ID=<AppClientId-from-CareAgentAuthStack-outputs>
VITE_API_BASE_URL=<ApiUrl-from-CareAgentApiStack-outputs>
